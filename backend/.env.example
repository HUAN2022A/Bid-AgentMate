# 数据库 / Redis（Docker Compose 内服务名）
DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/bidagentmate
REDIS_URL=redis://redis:6379/0

# 文件存储根目录（容器内挂 volume）
DATA_ROOT=./data

# 认证（生产部署务必修改）
JWT_SECRET=change-me-in-production
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=admin123

# 上传限制（MB）
MAX_UPLOAD_MB=200

# LLM（OpenAI 兼容协议；本地 vLLM/Ollama 改 base_url 即可）
LLM__BASE_URL=https://api.openai.com/v1
LLM__API_KEY=
LLM__MODEL=gpt-4o
LLM__TEMPERATURE=0.3
LLM__MAX_TOKENS=8192
LLM__TIMEOUT_SECONDS=900
LLM__MAX_RETRIES=2

# 本地开发演示：true 时解析任务同步执行，无需起 Redis/Celery
SYNC_TASKS=false
